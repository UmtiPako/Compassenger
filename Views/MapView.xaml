<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             x:Class="Compassenger.Views.MapView"
             Title="HARİTA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Üst Bilgi Mesajı -->
        <Frame Grid.Row="0" 
               BackgroundColor="#2196F3" 
               Padding="15,10" 
               Margin="10,10,10,5"
               CornerRadius="8"
               HasShadow="True">
            <Label Text="Başlamak İçin Haritadan Nokta Seçiniz"
                   TextColor="White"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Frame>

        <!-- Mapsui Harita Kontrolü -->
        <Frame Grid.Row="1" 
               Margin="10,5,10,10"
               Padding="0"
               CornerRadius="12"
               HasShadow="True"
               BackgroundColor="White">
            <Grid>
                <mapsui:MapView x:Name="MV"
                                VerticalOptions="FillAndExpand"
                                HorizontalOptions="FillAndExpand" />

                <!-- Anlık Pozisyon Butonu -->
                <Button x:Name="GetLocationButton"
                        Text="📍 Anlık Pozisyonu Al"
                        BackgroundColor="#FF5722"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        WidthRequest="160"
                        HeightRequest="45"
                        CornerRadius="22"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="15"
                        Clicked="OnGetLocationClicked" />

                <!-- Pin Bilgi Kartı (Pin eklenince görünür) -->
                <Frame x:Name="PinInfoCard"
                       IsVisible="False"
                       BackgroundColor="White"
                       Padding="15"
                       CornerRadius="12"
                       HasShadow="True"
                       HorizontalOptions="Center"
                       VerticalOptions="End"
                       Margin="20,20,20,80"
                       WidthRequest="350">
                    <StackLayout Spacing="12">

                        <!-- Başlık -->
                        <Label Text="Lokasyon İsmi Girin"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#333"
                               HorizontalOptions="Center" />

                        <!-- İsim TextBox -->
                        <Entry x:Name="LocationNameEntry"
                               Placeholder="Örn: Ev, İş, Okul..."
                               FontSize="15"
                               BackgroundColor="#F5F5F5"
                               TextColor="#333"
                               PlaceholderColor="#999" />

                        <!-- Butonlar -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                            <Button Grid.Column="0"
                                    x:Name="SaveButton"
                                    Text="💾 Kaydet"
                                    BackgroundColor="#4CAF50"
                                    TextColor="White"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    Clicked="OnSaveLocationClicked" />

                            <Button Grid.Column="1"
                                    x:Name="StartButton"
                                    Text="▶️ Direkt Başla"
                                    BackgroundColor="#2196F3"
                                    TextColor="White"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    Clicked="OnStartDirectlyClicked" />

                        </Grid>

                        <!-- İptal Butonu -->
                        <Button Text="❌ İptal"
                                BackgroundColor="#F44336"
                                TextColor="White"
                                FontSize="13"
                                CornerRadius="8"
                                Clicked="OnCancelPinClicked" />

                    </StackLayout>
                </Frame>

            </Grid>
        </Frame>

    </Grid>
</ContentPage>