<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Compassenger.Views.CompassPage"
             Title="Compass"
             BackgroundColor="Black"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- Background Gradient -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#190649" Offset="0.1" />
                    <GradientStop Color="#000000" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Main Layout -->
        <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="20">

            <!-- Top Bar with Close Button -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" HeightRequest="60">
                <Label Text="Navigasyon" 
                       TextColor="White" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
                
                <ImageButton Grid.Column="1"
                             Source="dotnet_bot.png" 
                             WidthRequest="40"
                             HeightRequest="40"
                             CornerRadius="20"
                             BackgroundColor="#33FFFFFF"
                             Clicked="OnCloseClicked"
                             VerticalOptions="Center">
                             <!-- Using dotnet_bot as placeholder if X icon not avail, or text button -->
                             <!-- Let's replace with a simple text button for clarity if no icon -->
                </ImageButton>
                 <Button Grid.Column="1"
                        Text="✕"
                        TextColor="White"
                        BackgroundColor="#33FFFFFF"
                        WidthRequest="40"
                        HeightRequest="40"
                        CornerRadius="20"
                        FontSize="18"
                        Padding="0"
                        Clicked="OnCloseClicked"
                        VerticalOptions="Center"/>
            </Grid>

            <!-- Compass Section -->
            <Grid Grid.Row="1" VerticalOptions="Center">
                <!-- Compass Circle/Background Ring -->
                <Border Stroke="#33FFFFFF" 
                        StrokeThickness="2"
                        WidthRequest="280"
                        HeightRequest="280"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="140"/>
                    </Border.StrokeShape>
                    <Grid>
                        <!-- Cardinal Points -->
                        <Label Text="N" TextColor="#FF5722" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,10,0,0"/>
                        <Label Text="S" TextColor="Gray" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,10"/>
                        <Label Text="W" TextColor="Gray" FontSize="20" FontAttributes="Bold" HorizontalOptions="Start" VerticalOptions="Center" Margin="10,0,0,0"/>
                        <Label Text="E" TextColor="Gray" FontSize="20" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,10,0"/>
                        
                        <!-- The Rotating Arrow -->
                        <Image x:Name="_arrow"
                               Source="arrow.png"
                               WidthRequest="180"
                               HeightRequest="180"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Distance Info -->
            <VerticalStackLayout Grid.Row="2" Spacing="5" Margin="0,20">
                <Label Text="HEDEFE KALAN" 
                       TextColor="#AAAAAA" 
                       FontSize="12" 
                       CharacterSpacing="2"
                       HorizontalOptions="Center"/>
                
                <Label x:Name="_distance"
                       Text="0 m"
                       TextColor="#00E676"
                       FontSize="64"
                       FontFamily="OpenSansSemibold"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                       
                 <Label x:Name="_targetName"
                       Text="Hedef Noktası"
                       TextColor="White" 
                       FontSize="18" 
                       HorizontalOptions="Center"
                       Opacity="0.8"/>
            </VerticalStackLayout>

            <!-- Footer Instruction -->
            <Frame Grid.Row="3" 
                   BackgroundColor="#22FFFFFF" 
                   Padding="15" 
                   CornerRadius="10" 
                   HasShadow="False"
                   Margin="0,0,0,20">
                <Label Text="Cihazı yere paralel tutun ve ok yönünde ilerleyin." 
                       TextColor="#DDDDDD" 
                       FontSize="14" 
                       HorizontalOptions="Center" 
                       HorizontalTextAlignment="Center"/>
            </Frame>

        </Grid>
    </Grid>

</ContentPage>