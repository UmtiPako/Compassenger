<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Compassenger.Models"
             x:Class="Compassenger.Views.LocationsView"
             Title="LOKASYONLARIM">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Frame Grid.Row="0" 
               BackgroundColor="#4CAF50" 
               Padding="15,10" 
               Margin="10,10,10,5"
               CornerRadius="8"
               HasShadow="True">
            <Label Text="Kayıtlı Lokasyonlarım"
                   TextColor="White"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Frame>

        <!-- Lokasyon Listesi -->
        <RefreshView Grid.Row="1" x:Name="LocationsRefreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="LocationsCollection" 
                            SelectionMode="None" 
                            Margin="10,5"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">
                <CollectionView.Footer>
                    <StackLayout x:Name="LoadingFooter" IsVisible="False" Padding="10">
                        <ActivityIndicator IsRunning="True" Color="#4CAF50" HorizontalOptions="Center" />
                    </StackLayout>
                </CollectionView.Footer>
                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📍" 
                               FontSize="48" 
                               HorizontalOptions="Center" />
                        <Label Text="Henüz kayıtlı lokasyon yok" 
                               FontSize="16" 
                               TextColor="#666"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Waypoint">
                        <Grid Padding="5" Margin="0,0,0,12">
                            <Border StrokeShape="RoundRectangle 15"
                                    StrokeThickness="0"
                                    BackgroundColor="White"
                                    HeightRequest="100">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.1" />
                                </Border.Shadow>
                                
                                <Grid ColumnDefinitions="12,*,Auto,Auto,Auto" Padding="0,0,10,0">
                                    <!-- Left Color Strip -->
                                    <BoxView Grid.Column="0" Color="#4CAF50"/>
                                    
                                    <!-- Content -->
                                    <StackLayout Grid.Column="1" VerticalOptions="Center" Padding="15,0,0,0" Spacing="4">
                                        <Label Text="{Binding Name}" 
                                               FontSize="18" 
                                               FontAttributes="Bold" 
                                               TextColor="#333333" 
                                               LineBreakMode="TailTruncation" />
                                        
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding Latitude, StringFormat='Lat: {0:F4}'}" 
                                                   FontSize="12" 
                                                   TextColor="#757575" />
                                            <Label Text="|" TextColor="#DDDDDD"/>
                                            <Label Text="{Binding Longitude, StringFormat='Lon: {0:F4}'}" 
                                                   FontSize="12" 
                                                   TextColor="#757575" />
                                        </HorizontalStackLayout>
                                    </StackLayout>

                                    <!-- Share Action -->
                                    <ImageButton Grid.Column="2"
                                                 Source="share.png"
                                                 BackgroundColor="Transparent"
                                                 WidthRequest="40"
                                                 HeightRequest="40"
                                                 VerticalOptions="Center"
                                                 Clicked="OnShareClicked"
                                                 CommandParameter="{Binding .}"
                                                 Margin="0,0,5,0"
                                                 Padding="8"/>

                                    <!-- Delete Action -->
                                    <ImageButton Grid.Column="3"
                                                 Source="delete.png"
                                                 BackgroundColor="Transparent"
                                                 WidthRequest="40"
                                                 HeightRequest="40"
                                                 VerticalOptions="Center"
                                                 Clicked="OnDeleteClicked"
                                                 CommandParameter="{Binding .}"
                                                 Margin="0,0,5,0"
                                                 Padding="8"/>

                                    <!-- Go Action -->
                                    <Button Grid.Column="4"
                                            Text="➤"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            BackgroundColor="#E8F5E9"
                                            TextColor="#2E7D32"
                                            WidthRequest="50"
                                            HeightRequest="50"
                                            CornerRadius="25"
                                            VerticalOptions="Center"
                                            Clicked="OnNavigateToLocationClicked" 
                                            CommandParameter="{Binding .}"
                                            Margin="5,0,5,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>